# --- App ---
APP_ENV=development
LOG_LEVEL=INFO
SECRET_KEY=change-me
# Publicly reachable base URL for this API (ngrok URL in dev, real
# domain in production) -- used to build outbound-call TwiML callbacks.
PUBLIC_BASE_URL=https://your-domain.example.com

# --- Database ---
DATABASE_URL=postgresql://mortgage_user:mortgage_pass@localhost:5432/mortgage_agent
REDIS_URL=redis://localhost:6379/0

# --- Google Gemini Live API (speech-to-speech) ---
# Server-to-server auth via Vertex AI is recommended for production
# (service-account JSON, no long-lived API key on the client).
GOOGLE_GENAI_USE_VERTEXAI=true
GOOGLE_CLOUD_PROJECT=your-gcp-project
GOOGLE_CLOUD_LOCATION=us-central1
GOOGLE_APPLICATION_CREDENTIALS=/secrets/vertex-sa.json
# Fallback for local dev against the plain Gemini API instead of Vertex:
GEMINI_API_KEY=

# Model IDs are configurable because Google ships new Live model
# revisions frequently -- always confirm the current GA model id
# in the Gemini Live API docs before deploying.
GEMINI_LIVE_MODEL=gemini-live-2.5-flash-native-audio

# --- Document analysis ---
DOC_STORAGE_BUCKET=mortgage-agent-docs
OCR_ENGINE=tesseract

# --- Notifications ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SENDGRID_API_KEY=
NOTIFY_FROM_EMAIL=loans@example.com

# --- Compliance ---
RECORD_CALLS=true
CALL_RETENTION_DAYS=2555   # 7 years, common mortgage record-retention window (confirm w/ counsel)
